{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cuttoon-copilot.local/spec/preset.schema.json",
  "title": "Preset",
  "description": "프로젝트 단위 1회 확정값",
  "type": "object",
  "required": ["preset_version", "assets", "style", "rules", "context"],
  "additionalProperties": false,
  "properties": {
    "preset_version": {
      "type": "string",
      "enum": ["1.0"]
    },
    "assets": {
      "type": "object",
      "required": ["character_sheet", "style_refs", "reference_asset_ids"],
      "additionalProperties": false,
      "properties": {
        "character_sheet": {
          "type": "string",
          "pattern": "^asset://",
          "description": "필수. 캐릭터 동일성은 텍스트 서술로 대체 불가 — 매 컷 reference 주입의 근거 애셋"
        },
        "style_refs": {
          "type": "array",
          "items": { "type": "string", "pattern": "^asset://" },
          "uniqueItems": true,
          "description": "그림체 레퍼런스 업로드 애셋. 온보딩에서 스킵 가능 — 빈 배열이면 기본 스타일 적용"
        },
        "reference_asset_ids": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true,
          "description": "누적 메모리용. 지금은 항상 빈 배열 — 필드만 미리 박아 마이그레이션 회피"
        }
      }
    },
    "style": {
      "type": "object",
      "description": "레퍼런스에서 추출한 스타일 값의 확정 결과",
      "required": [
        "line_weight",
        "palette",
        "saturation",
        "character_ratio",
        "background_density",
        "bubble_style"
      ],
      "additionalProperties": false,
      "properties": {
        "line_weight": { "type": "string", "enum": ["thin", "medium", "thick"] },
        "palette": {
          "type": "array",
          "items": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "minItems": 1,
          "uniqueItems": true
        },
        "saturation": { "type": "string", "enum": ["pastel", "vivid", "muted"] },
        "character_ratio": {
          "type": "string",
          "enum": ["2head", "2.5head", "3head", "realistic"],
          "description": "캐릭터 두신 비율과 스타일을 하나로 묶은 선택지(의도적 결합) — 2~3두신 카툰 비율 또는 실사형"
        },
        "background_density": {
          "type": "string",
          "enum": ["none", "low", "medium", "high"],
          "description": "배경 단순화(협상 불가 고정값)를 스키마로 강제하는 필드"
        },
        "bubble_style": {
          "type": "string",
          "enum": ["rounded", "rect", "cloud"],
          "description": "vocabulary.json의 bubble_type과 동일한 값 집합 — 값 변경 시 두 파일을 함께 갱신"
        }
      }
    },
    "rules": {
      "type": "object",
      "required": ["characters", "forbidden", "cta_format"],
      "additionalProperties": false,
      "properties": {
        "characters": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "description": "등장 캐릭터 1~2명(협상 불가 고정값). 정확히 1명은 protagonist여야 함",
          "items": {
            "type": "object",
            "required": ["name", "role"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "role": {
                "type": "string",
                "enum": ["protagonist", "supporting"]
              }
            }
          },
          "contains": {
            "type": "object",
            "properties": { "role": { "const": "protagonist" } },
            "required": ["role"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        "forbidden": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true,
          "description": "네거티브 요소. 단어 단위 태그 — enum 아님. 프롬프트 조립 시 미매핑 단어 위험 있음(검증 로직 미정)"
        },
        "cta_format": {
          "type": "string",
          "minLength": 1,
          "description": "마지막 컷 CTA. 값 목록은 코드가 아니라 JSON 데이터 파일(cta_presets.json, 미작성)로 분리 예정 — 목록 확정 전까지 자유 문자열"
        }
      }
    },
    "context": {
      "type": "object",
      "description": "온보딩에서 수집하는 프로젝트 설정값. 각 필드는 빈 배열로 스킵 가능(assets/rules의 forbidden·style_refs와 동일한 규약)",
      "required": ["interests", "age_band", "life_stage", "main_subjects"],
      "additionalProperties": false,
      "properties": {
        "interests": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "brand_awareness",
              "trust_building",
              "product_showcase",
              "sales_conversion",
              "event_promotion",
              "info_education",
              "lead_generation",
              "recruiting"
            ]
          },
          "description": "마케팅 목적 축(업종 무관, 목적만). 브랜드 인지도/신뢰형성/제품소개/구매전환/이벤트홍보/정보전달/문의확보/모집"
        },
        "age_band": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["10s", "20s", "30s", "40s", "50s", "60s_plus"]
          },
          "description": "타깃층 — 연령대 축"
        },
        "life_stage": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["student", "job_seeker", "early_career", "parent", "business_owner", "retired"]
          },
          "description": "타깃층 — 생활단계 축(연령대와 독립, 동시 선택 가능)"
        },
        "main_subjects": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true,
          "description": "주요 소재. 자유 키워드를 단어 단위로 잘라 태그로 입력 — enum 아님. forbidden과 동일하게 프롬프트 조립 시 미매핑 단어 위험 있음"
        }
      }
    }
  }
}
