OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 이미지 생성 설정 (선택). 비우면 openai. 개발·QA 비용 절감용: openai-low · 로컬 ComfyUI: comfyui
IMAGE_PROVIDER=
# IMAGE_PROVIDER=comfyui 일 때만 (개발 테스트 전용 로컬 생성, #190). 예: http://127.0.0.1:8188
COMFYUI_URL=
# IMAGE_PROVIDER=comfyui 일 때 그림 모델 (선택). 비우면 sdxl(한국어는 영어로 번역 후 생성) · zimage(한국어 그대로)
COMFYUI_MODEL=
# ComfyUI 한 장 대기 상한(밀리초, 선택). 비우면 5분. Z-Image 는 표지 3안에 약 12분이 걸려 1200000 정도 권장
# 한계: 이 값은 ComfyUI 를 기다리는 시간만 늘린다. /api/generate 에는 지금 maxDuration 설정이 없어 로컬(npm run dev·start)에서는
#       요청이 시간으로 끊기지 않지만, 배포 플랫폼에 올리면 그 플랫폼의 실행 시간 상한에서 먼저 끊길 수 있다
COMFYUI_TIMEOUT_MS=
